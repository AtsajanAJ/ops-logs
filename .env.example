# Neon pooled connection string. Keep the real value in .env.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Google AI Studio key. Required only when generating a weekly summary.
GEMINI_API_KEY=""

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (optional). Callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email that becomes SUPER_ADMIN on first register (bootstrap only).
ADMIN_EMAIL=""
